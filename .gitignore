.turbo

# Database
# ============================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
pgdata/
postgres-data/

# Output & Logs
# ============================================
out/
logs/
*.log
*.log.*
tmp/
temp/
*.tmp

# Alembic
# ============================================
# Keep migrations but ignore temp files
alembic/versions/__pycache__/

# UV Package Manager
# ============================================
.uv/

# Data & Uploads (keep structure, ignore contents)
# ============================================
data/*
!data/.gitkeep
!data/README.md
!data/demo/
uploads/
*.csv
!data/demo/*.csv
*.xlsx
*.xls

# Private/Sensitive
# ============================================
evaluator_private/
ground_truth_*.json
*.backup
*.bak

# OS & System
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Docker
# ============================================
docker-compose.override.yml

# Jupyter Notebooks
# ============================================
.ipynb_checkpoints
*.ipynb

# Misc
# ============================================
.cache/
.parcel-cache/
.sass-cache/
*.pid
*.seed
*.pid.lock

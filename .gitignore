.env.local
.env.*.local
*.pem
*.key
*.crt
secrets.yaml
credentials.json

# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
# ============================================
.venv/
venv/
ENV/
env/
.virtualenv/


# ============================================
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
.pyre/
pyrightconfig.json

# IDEs & Editors
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Node.js & Frontend
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnpm-store/

# Next.js
# ============================================
.next/
.next-phase5-dev/
.next-playwright/
.next-e2e/

# ============================================
# ClearLedger Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Web & API Ports
WEB_PORT=3200
API_PORT=18000

# Database Configuration
# ============================================
# Local Docker PostgreSQL (default)
# DATABASE_URL=postgresql+psycopg://clearledger:clearledger@localhost:5432/clearledger

# Neon Cloud PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+psycopg://user:password@host.region.neon.tech/dbname?sslmode=require&channel_binding=require

# Direct connection (bypasses pooler, useful for migrations)
# DATABASE_DIRECT_URL=postgresql+psycopg://user:password@host.region.neon.tech/dbname?sslmode=require

# AI Configuration
# ============================================
AI_ENABLED=false
AI_PROVIDER=none

# Options: openai, anthropic, huggingface, azure, none
# AI_PROVIDER=openai

# Your AI API key (keep secret!)
# AI_API_KEY=sk-...

# Model identifier
# AI_MODEL=gpt-4-turbo

# Optional: Custom endpoint for OpenAI-compatible APIs
# AI_BASE_URL=https://api.openai.com/v1

# AI Performance Tuning
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_MAX_CASES_PER_RUN=20
AI_PROMPT_VERSION=exception_analyst.v1
AI_MAX_PACKET_CHARS=12000

# Pricing (USD per 1k tokens)
AI_INPUT_COST_PER_1K_TOKENS=0.00004
AI_OUTPUT_COST_PER_1K_TOKENS=0.00015

# Application Settings
# ============================================
APP_ENV=development
APP_NAME=clearledger
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000

# File Upload
UPLOAD_DIR=/tmp/clearledger_uploads
MAX_UPLOAD_BYTES=10485760  # 10MB

# Policy & Data Paths (relative to project root)
DEFAULT_POLICY_PATH=policies/settlement_policy.v1.json
GROUND_TRUTH_PATH=evaluator_private/ground_truth_demo.json

# Security
# ============================================
ALLOW_EXTERNAL_WRITES=false

# Currency & Locale
DEFAULT_CURRENCY=INR
UTC_TIMEZONE=UTC

# ============================================
# Advanced Configuration (usually keep defaults)
# ============================================

# Database Connection Pool
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# API Rate Limiting
# RATE_LIMIT_PER_MINUTE=60

# Session & Auth (if implementing authentication)
# SECRET_KEY=your-secret-key-here
# SESSION_TIMEOUT=3600
